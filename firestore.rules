rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Solo el usuario puede leer y actualizar su propio documento
      allow read, update: if request.auth != null
        && request.auth.uid == userId;
      
      // Solo los usuarios autenticados pueden crear
      allow create: if request.auth != null
        && request.auth.uid == userId;
      
      // No se permite eliminar el documento del usuario
      allow delete: if false;

      // Subcoleción de tareas
      match /tasks/{taskId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Subcoleción de apuntes
      match /notes/{noteId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Documento de mascota
      match /pet/{petId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid == userId;
        // No se permite eliminar la mascota
        allow delete: if false;
      }
    }

    // Denegar acceso a todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
